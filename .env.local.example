# Copy to .env.local and fill in with your FreeAgent Developer Dashboard app credentials.
# This is separate from freeagent-import/.env — that CLI scaffold's app is registered
# for http://localhost:8090/callback, so this Next.js app needs its own redirect URI
# registered (or added as an extra redirect URI on the same app, if supported).

FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_REDIRECT_URI=http://localhost:3000/api/oauth/callback
FREEAGENT_ENV=sandbox
